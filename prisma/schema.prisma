datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id            String   @id @default(uuid())
  nama          String
  email         String   @unique
  password_hash String?
  role          String   @default("noc_engineer") // admin, noc_engineer, field_engineer, sales_corporate
  created_at    DateTime @default(now())

  orders_created   PopSiteOrder[]      @relation("OrderCreator")
  progress_logs    OrderProgressLog[]
  test_results     TestResult[]
  data_change_logs SiteDataChangeLog[]

  @@map("users")
}

model PopSiteOrder {
  id                 String    @id @default(uuid())
  ticket_number      String    @unique // ACT-YYYYMMDD-XXXX

  // Category & Sub-service
  kategori_layanan   String    @default("POP Site") // "POP Site" | "Enterprise"
  sub_layanan        String?   // "LocalLoop" | "Collocation Rack" | "Dark Fiber" | "Content" | null

  // General Customer & PIC
  nama_pic           String
  kontak_pic         String    // JSON string array: ["0812...", "0857..."]
  nama_perusahaan    String?
  email_pic          String?
  alamat_instalasi   String?

  // Network & Specs
  ip_public          String?
  ip_private         String?
  vlan               Int?
  layanan_dedicated  String?
  server             String?
  infrastruktur      String?   // Fiber Optic, Wireless PTP, VSAT, Metro Cross-Connect
  media_koneksi      String?   // Metro Telkom, Direct Fiber ISP, Radio Ubiquiti, etc.
  sn_ont             String?

  // Enterprise specific fields
  kapasitas_layanan  String?   // e.g. "100 Mbps", "1 Gbps"
  interkoneksi       String?   // e.g. "Meet-Me Room DC", "Patch Panel F/O", "OpenIXP"
  port_media         String?   // Port Media Koneksi
  tipe_layanan_collo String?   // e.g. "Full Rack 42U", "Half Rack 21U", "1U Rackmount"
  nama_perangkat     String?   // e.g. "Server Dell PowerEdge R740"
  sn_perangkat       String?   // Serial Number perangkat collo
  prefix_advertise   String?   // JSON string array: ["103.xxx/24"]
  as_number          String?   // e.g. "AS13335"
  
  // Metro Telkom conditional fields
  sid                String?
  ao                 String?
  nomor_order        String?

  // Physical DCIM placement (3D Rack & 3D OTB)
  rack_id            String?
  rack               DataCenterRack? @relation(fields: [rack_id], references: [id], onDelete: SetNull)
  rack_code          String?
  rack_unit_start    Int?
  rack_unit_end      Int?
  otb_id             String?
  otb                OpticalOtb?     @relation(fields: [otb_id], references: [id], onDelete: SetNull)
  otb_code           String?
  otb_core_numbers   String?         // JSON array of allocated core numbers, e.g. "[1,2]"

  waktu_aktivasi     DateTime?
  catatan_tambahan   String?
  status             String    @default("Antrian Aktivasi") // Antrian Aktivasi, In Progress, Pending Issue, Completed, Terminated
  tipe_order         String    @default("Aktivasi Baru") // Aktivasi Baru, Upgrade, Downgrade, Isolir, Terminate
  
  pop_site_id        String?
  pop_site           PopSite?  @relation(fields: [pop_site_id], references: [id], onDelete: SetNull)

  created_by         String
  creator            User      @relation("OrderCreator", fields: [created_by], references: [id])
  created_at         DateTime  @default(now())
  completed_at       DateTime?

  progress_logs      OrderProgressLog[]
  test_results       TestResult[]

  @@map("pop_site_orders")
}

model PopSite {
  id                 String         @id @default(uuid())
  site_id            String         @unique // e.g. POP-202611-0001
  initial_ticket     String

  // Category & Sub-service
  kategori_layanan   String         @default("POP Site") // "POP Site" | "Enterprise"
  sub_layanan        String?        // "LocalLoop" | "Collocation Rack" | "Dark Fiber" | "Content" | null

  nama_pic           String
  kontak_pic         String         // JSON string array
  nama_perusahaan    String?
  email_pic          String?
  alamat_instalasi   String?

  ip_public          String?
  ip_private         String?
  vlan               Int?
  layanan_dedicated  String?
  server             String?
  infrastruktur      String?
  media_koneksi      String?
  sn_ont             String?

  // Enterprise specific fields
  kapasitas_layanan  String?
  interkoneksi       String?
  port_media         String?
  tipe_layanan_collo String?
  nama_perangkat     String?
  sn_perangkat       String?
  prefix_advertise   String?
  as_number          String?

  sid                String?
  ao                 String?
  nomor_order        String?

  // Physical DCIM placement (3D Rack & 3D OTB)
  rack_id            String?
  rack               DataCenterRack? @relation(fields: [rack_id], references: [id], onDelete: SetNull)
  rack_code          String?
  rack_unit_start    Int?
  rack_unit_end      Int?
  otb_id             String?
  otb                OpticalOtb?     @relation(fields: [otb_id], references: [id], onDelete: SetNull)
  otb_code           String?
  otb_core_numbers   String?

  status_layanan     String         @default("Active") // Active, Isolir, Terminated, Maintenance
  waktu_go_live      DateTime       @default(now())
  created_at         DateTime       @default(now())
  updated_at         DateTime       @default(now()) @updatedAt

  orders             PopSiteOrder[]
  data_change_logs   SiteDataChangeLog[]
  icmp_monitor       IcmpMonitor?
  network_devices    NetworkDevice[]

  @@map("pop_sites")
}

model IcmpMonitor {
  id              String          @id @default(uuid())
  pop_site_id     String          @unique
  name            String
  ip_address      String
  kategori        String
  status          String          @default("PENDING") // UP, DOWN, PENDING
  latency_ms      Float?
  uptime_pct      Float           @default(100.0)
  last_checked_at DateTime?
  interval_sec    Int             @default(60)
  is_active       Boolean         @default(true)
  created_at      DateTime        @default(now())
  updated_at      DateTime        @default(now()) @updatedAt

  heartbeats      IcmpHeartbeat[]
  pop_site        PopSite?        @relation(fields: [pop_site_id], references: [id], onDelete: Cascade)

  @@map("icmp_monitors")
}

model IcmpHeartbeat {
  id          String      @id @default(uuid())
  monitor_id  String
  monitor     IcmpMonitor @relation(fields: [monitor_id], references: [id], onDelete: Cascade)
  status      String      // UP, DOWN
  latency_ms  Float?
  msg         String?
  created_at  DateTime    @default(now())

  @@index([monitor_id, created_at])
  @@index([created_at])
  @@map("icmp_heartbeats")
}

model SiteDataChangeLog {
  id           String   @id @default(uuid())
  pop_site_id  String
  pop_site     PopSite  @relation(fields: [pop_site_id], references: [id], onDelete: Cascade)
  user_id      String
  user         User     @relation(fields: [user_id], references: [id])
  changes      String   // JSON string: array of { field: string, label: string, old_value: string | null, new_value: string | null }
  catatan      String?  // Alasan / catatan perubahan data
  created_at   DateTime @default(now())

  @@map("site_data_change_logs")
}

model OrderProgressLog {
  id               String       @id @default(uuid())
  order_id         String
  order            PopSiteOrder @relation(fields: [order_id], references: [id], onDelete: Cascade)
  user_id          String
  user             User         @relation(fields: [user_id], references: [id])
  action_type      String       // Status Change, Progress Note, Config Pushed, Test Uploaded
  status_sebelum   String?
  status_sesudah   String?
  catatan_progress String
  created_at       DateTime     @default(now())

  @@map("order_progress_logs")
}

model TestResult {
  id          String       @id @default(uuid())
  order_id    String
  order       PopSiteOrder @relation(fields: [order_id], references: [id], onDelete: Cascade)
  file_url    String
  file_name   String
  file_type   String       // image/jpeg, image/png, pdf, etc.
  uploaded_by String
  uploader    User         @relation(fields: [uploaded_by], references: [id])
  uploaded_at DateTime     @default(now())

  @@map("test_results")
}

model SheetsSyncLog {
  id               String   @id @default(uuid())
  order_id         String?
  event            String
  payload          String
  status           String   // SUCCESS, FAILED, PENDING
  response_message String?
  created_at       DateTime @default(now())

  @@map("sheets_sync_logs")
}

model SystemSetting {
  key        String   @id
  value      String
  updated_at DateTime @default(now()) @updatedAt

  @@map("system_settings")
}

model AppActivityLog {
  id           String   @id @default(uuid())
  nama_lengkap String
  email        String?
  ip_address   String   @default("127.0.0.1")
  tipe         String   @default("INFO") // LOGIN_SUCCESS, LOGIN_FAILED, LOGOUT, CREATE_TICKET, UPDATE_DATA, DELETE_DATA, SYSTEM
  aktifitas    String
  detail       String?
  user_agent   String?
  created_at   DateTime @default(now())

  @@index([created_at])
  @@index([nama_lengkap])
  @@index([tipe])
  @@map("app_activity_logs")
}

model NetworkDevice {
  id                  String    @id @default(uuid())
  name                String
  host                String
  port                Int       @default(22)
  vendor              String    @default("mikrotik") // mikrotik, cisco, juniper, huawei, custom
  platform            String?
  protocol            String    @default("ssh") // ssh, manual
  username            String?
  password_enc        String?
  enable_password_enc String?
  ssh_private_key_enc String?   @db.Text
  custom_command      String?
  pre_command         String?
  pop_site_id         String?
  pop_site            PopSite?  @relation(fields: [pop_site_id], references: [id], onDelete: SetNull)
  auto_backup_enabled Boolean   @default(true)
  schedule_mode       String    @default("global") // global, 1d, 3d, 7d, 30d, custom_days
  schedule_days       Int?
  schedule_time       String?   // Optional HH:MM WIB
  retention_count     Int       @default(30)
  gdrive_sync_enabled Boolean   @default(true)
  last_backup_at      DateTime?
  last_auto_backup_at DateTime?
  last_status         String    @default("IDLE") // IDLE, RUNNING, SUCCESS, FAILED
  last_error          String?   @db.Text
  created_by          String?
  created_at          DateTime  @default(now())
  updated_at          DateTime  @default(now()) @updatedAt

  backups NetworkConfigBackup[]

  @@index([vendor])
  @@index([auto_backup_enabled])
  @@map("network_devices")
}

model NetworkConfigBackup {
  id                String        @id @default(uuid())
  device_id         String
  device            NetworkDevice @relation(fields: [device_id], references: [id], onDelete: Cascade)
  backup_type       String        @default("manual") // auto, manual, upload
  status            String        @default("SUCCESS") // SUCCESS, FAILED
  config_content    String        @db.Text
  config_hash       String
  line_count        Int           @default(0)
  size_bytes        Int           @default(0)
  changed_from_prev Boolean       @default(true)
  diff_added        Int           @default(0)
  diff_removed      Int           @default(0)
  command_used      String?
  error_message     String?       @db.Text
  triggered_by      String?
  gdrive_status     String        @default("PENDING") // PENDING, SYNCED, FAILED, SKIPPED
  gdrive_file_id    String?
  gdrive_file_url   String?
  gdrive_synced_at  DateTime?
  gdrive_error      String?       @db.Text
  created_at        DateTime      @default(now())

  @@index([device_id, created_at])
  @@index([status, created_at])
  @@index([gdrive_status])
  @@map("network_config_backups")
}

model DataCenterRack {
  id                String               @id @default(uuid())
  code              String               @unique // e.g. DC-CYBER1-R01
  name              String
  location          String
  room_zone         String?
  total_u           Int                  @default(42)
  power_capacity_va Int?                 @default(5000)
  status            String               @default("Active") // Active, Maintenance, Full, Decommissioned
  notes             String?              @db.Text
  created_at        DateTime             @default(now())
  updated_at        DateTime             @default(now()) @updatedAt

  slots     RackUnitAllocation[]
  orders    PopSiteOrder[]
  pop_sites PopSite[]

  @@map("data_center_racks")
}

model RackUnitAllocation {
  id              String         @id @default(uuid())
  rack_id         String
  rack            DataCenterRack @relation(fields: [rack_id], references: [id], onDelete: Cascade)
  start_u         Int
  unit_size       Int            @default(1)
  end_u           Int
  device_name     String
  serial_number   String?
  customer_name   String?
  pic_name        String?
  device_type     String         @default("Server") // Server, Switch, Router, Firewall, Storage, Patch Panel, PDU, Collocation Block, Other
  power_draw_watt Int?           @default(450)
  color_tag       String         @default("#3b82f6")
  status          String         @default("Occupied") // Occupied, Reserved, Maintenance
  order_id        String?
  pop_site_id     String?
  ticket_number   String?
  site_code       String?
  notes           String?        @db.Text
  created_at      DateTime       @default(now())
  updated_at      DateTime       @default(now()) @updatedAt

  @@index([rack_id, start_u, end_u])
  @@index([order_id])
  @@index([pop_site_id])
  @@map("rack_unit_allocations")
}

model OpticalOtb {
  id             String         @id @default(uuid())
  code           String         @unique // e.g. OTB-CYBER2-01
  name           String
  location       String
  pop_node       String?
  total_cores    Int            @default(48)
  cores_per_tray Int            @default(12)
  connector_type String         @default("SC/UPC") // SC/UPC, SC/APC, LC/UPC, LC/APC, FC/UPC
  fiber_mode     String         @default("Single-Mode G.652D")
  status         String         @default("Active") // Active, Maintenance, Full
  notes          String?        @db.Text
  created_at     DateTime       @default(now())
  updated_at     DateTime       @default(now()) @updatedAt

  ports     OtbCorePort[]
  orders    PopSiteOrder[]
  pop_sites PopSite[]

  @@map("optical_otbs")
}

model OtbCorePort {
  id              String     @id @default(uuid())
  otb_id          String
  otb             OpticalOtb @relation(fields: [otb_id], references: [id], onDelete: Cascade)
  core_number     Int
  tray_number     Int        @default(1)
  tube_color      String
  core_color      String
  status          String     @default("Available") // Available, Reserved, Used, Damaged, Maintenance
  route_pair      String?
  destination_otb String?
  customer_name   String?
  attenuation_db  Float?
  distance_km     Float?
  order_id        String?
  pop_site_id     String?
  ticket_number   String?
  site_code       String?
  notes           String?
  updated_at      DateTime   @default(now()) @updatedAt

  @@unique([otb_id, core_number])
  @@index([otb_id, tray_number])
  @@index([order_id])
  @@index([pop_site_id])
  @@map("otb_core_ports")
}

// ============================================================================
// TACACS+ AAA SERVER MODELS (RFC 8907)
// ============================================================================

model TacacsGroup {
  id              String       @id @default(uuid())
  name            String       @unique
  description     String?
  privilege_level Int          @default(15) // 0..15
  default_policy  String       @default("deny") // permit, deny
  command_rules   String       @default("[]") @db.Text // JSON array of { id, action, pattern, description }
  service_attrs   String?      @db.Text // JSON array of { key, value } e.g. Mikrotik-Group=full
  is_active       Boolean      @default(true)
  created_at      DateTime     @default(now())
  updated_at      DateTime     @default(now()) @updatedAt

  users TacacsUser[]

  @@map("tacacs_groups")
}

model TacacsUser {
  id                   String       @id @default(uuid())
  username             String       @unique
  full_name            String?
  password_hash        String
  chap_secret_enc      String?      // AES-256-GCM encrypted password for CHAP/MS-CHAP support
  enable_password_hash String?      // Optional separate enable password hash
  privilege_level      Int?         // Optional override (0..15); null inherits from group
  group_id             String?
  group                TacacsGroup? @relation(fields: [group_id], references: [id], onDelete: SetNull)
  is_active            Boolean      @default(true)
  expires_at           DateTime?
  last_login_at        DateTime?
  last_login_ip        String?
  notes                String?      @db.Text
  created_by           String?
  created_at           DateTime     @default(now())
  updated_at           DateTime     @default(now()) @updatedAt

  @@index([group_id])
  @@index([is_active])
  @@map("tacacs_users")
}

model TacacsClient {
  id                String    @id @default(uuid())
  name              String
  ip_or_cidr        String    // Single IP (e.g. 10.10.1.1) or CIDR (e.g. 10.10.0.0/24)
  vendor            String    @default("cisco") // cisco, mikrotik, juniper, huawei, arista, fortinet, custom
  shared_secret_enc String    // AES-256-GCM encrypted TACACS+ shared key
  network_device_id String?   // Optional reference to NetworkDevice.id
  pop_site_id       String?   // Optional reference to PopSite.id
  is_active         Boolean   @default(true)
  description       String?
  last_seen_at      DateTime?
  created_at        DateTime  @default(now())
  updated_at        DateTime  @default(now()) @updatedAt

  @@index([is_active])
  @@index([vendor])
  @@map("tacacs_clients")
}

model TacacsAuditLog {
  id          String   @id @default(uuid())
  event_type  String   // AUTHEN, AUTHOR, ACCT
  status      String   // PASS, FAIL, ERROR, START, STOP, UPDATE
  username    String
  client_ip   String
  client_name String?
  remote_addr String?
  port        String?
  authen_type String?  // ASCII, PAP, CHAP, ENABLE
  service     String?  // shell, exec, ppp, etc.
  priv_lvl    Int?
  command     String?  @db.Text
  args_json   String?  @db.Text
  session_id  String?
  elapsed_sec Int?
  detail      String?  @db.Text
  created_at  DateTime @default(now())

  @@index([created_at])
  @@index([event_type, created_at])
  @@index([username, created_at])
  @@index([client_ip])
  @@map("tacacs_audit_logs")
}

// ============================================================================
// INVENTORY MANAGEMENT SYSTEM MODELS
// ============================================================================

model InventoryCategory {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  created_at  DateTime @default(now())
  updated_at  DateTime @default(now()) @updatedAt

  items InventoryItem[]

  @@map("inventory_categories")
}

model InventoryItem {
  id               String   @id @default(uuid())
  code             String   @unique // e.g. ITM-ROU-0001
  name             String
  category_id      String
  category         InventoryCategory @relation(fields: [category_id], references: [id], onDelete: Restrict)
  type             String   // "REUSABLE" | "CONSUMABLE"
  brand            String?
  model            String?
  serial_number    String?
  unit             String   @default("Unit") // Unit, Pcs, Meter, Roll, Box, Set, etc.
  min_stock        Decimal  @default(0) @db.Decimal(12, 2)
  storage_location String?  // e.g. "Gudang Utama Rak A1"
  description      String?  @db.Text
  image_url        String?
  is_active        Boolean  @default(true)
  created_at       DateTime @default(now())
  updated_at       DateTime @default(now()) @updatedAt

  stock               InventoryStock?
  units               InventoryItemUnit[]
  transaction_details InventoryTransactionDetail[]
  movements           InventoryMovement[]
  return_details      InventoryReturnDetail[]

  @@index([category_id])
  @@index([type])
  @@index([is_active])
  @@map("inventory_items")
}

model InventoryItemUnit {
  id               String        @id @default(uuid())
  item_id          String
  item             InventoryItem @relation(fields: [item_id], references: [id], onDelete: Cascade)
  serial_number    String        @unique
  mac_address      String?
  status           String        @default("AVAILABLE") // "AVAILABLE", "IN_USE", "DAMAGED", "LOST", "DISPOSED"
  condition        String        @default("BAIK")      // "BAIK", "RUSAK_RINGAN", "RUSAK_BERAT", "HILANG"
  current_pic      String?
  current_location String?
  created_at       DateTime      @default(now())
  updated_at       DateTime      @default(now()) @updatedAt

  @@index([item_id])
  @@index([status])
  @@map("inventory_item_units")
}

model InventoryStock {
  id              String        @id @default(uuid())
  item_id         String        @unique
  item            InventoryItem @relation(fields: [item_id], references: [id], onDelete: Cascade)
  initial_stock   Decimal       @default(0) @db.Decimal(12, 2)
  total_in        Decimal       @default(0) @db.Decimal(12, 2)
  total_out       Decimal       @default(0) @db.Decimal(12, 2)
  total_in_use    Decimal       @default(0) @db.Decimal(12, 2) // Reusable currently deployed/outside
  total_returned  Decimal       @default(0) @db.Decimal(12, 2) // Reusable returned to stock
  total_consumed  Decimal       @default(0) @db.Decimal(12, 2) // Consumable permanently consumed
  total_damaged   Decimal       @default(0) @db.Decimal(12, 2) // Returned broken / quarantined
  total_lost      Decimal       @default(0) @db.Decimal(12, 2) // Lost / missing
  available_stock Decimal       @default(0) @db.Decimal(12, 2) // Ready to be issued in warehouse
  updated_at      DateTime      @default(now()) @updatedAt

  @@map("inventory_stocks")
}

model InventoryTransaction {
  id                 String    @id @default(uuid())
  transaction_number String    @unique // e.g. OUT-20261113-0001, IN-20261113-0001, ADJ-20261113-0001, OPN-20261113-0001
  type               String    // "IN", "OUT", "ADJUSTMENT", "OPNAME"
  transaction_date   DateTime  @default(now())
  pic_name           String?
  pic_phone          String?
  department         String?   // "NOC", "Field Operations", "Enterprise", "Infrastructure", etc.
  location           String?   // Location of usage / POP Site / Data Center
  purpose            String?   // Reason / Purpose / Ticket assignment
  warehouse_officer  String    // Staff in charge of warehouse dispatch/receipt
  status             String    @default("COMPLETED") // For OUT: "SEDANG_DIGUNAKAN", "SEBAGIAN_KEMBALI", "SUDAH_KEMBALI", "TERPAKAI", "COMPLETED"
  notes              String?   @db.Text
  permit_id          String?   // Reference to Permit Barang ID if linked
  permit_number      String?   // Reference permit document number e.g. PM/101/XII/2025/JDP
  created_by         String?
  created_at         DateTime  @default(now())
  updated_at         DateTime  @default(now()) @updatedAt

  details   InventoryTransactionDetail[]
  returns   InventoryReturn[]
  movements InventoryMovement[]

  @@index([type, transaction_date])
  @@index([status])
  @@index([pic_name])
  @@map("inventory_transactions")
}

model InventoryTransactionDetail {
  id                  String               @id @default(uuid())
  transaction_id      String
  transaction         InventoryTransaction @relation(fields: [transaction_id], references: [id], onDelete: Cascade)
  item_id             String
  item                InventoryItem        @relation(fields: [item_id], references: [id], onDelete: Restrict)
  quantity            Decimal              @db.Decimal(12, 2)
  unit                String               @default("Unit")
  unit_serial_numbers String?              // JSON array string of serial numbers: ["SN1", "SN2"]
  qty_returned        Decimal              @default(0) @db.Decimal(12, 2)
  qty_remaining       Decimal              @default(0) @db.Decimal(12, 2)
  status              String               @default("ACTIVE") // "ACTIVE", "PARTIAL_RETURN", "FULLY_RETURNED", "CONSUMED"
  notes               String?

  returns InventoryReturnDetail[]

  @@index([transaction_id])
  @@index([item_id])
  @@map("inventory_transaction_details")
}

model InventoryReturn {
  id                 String               @id @default(uuid())
  return_number      String               @unique // e.g. RET-20261113-0001
  out_transaction_id String
  out_transaction    InventoryTransaction @relation(fields: [out_transaction_id], references: [id], onDelete: Restrict)
  pic_name           String               // Name of returning PIC
  recipient_officer  String               // Name of warehouse receiver
  return_date        DateTime             @default(now())
  notes              String?              @db.Text
  created_by         String?
  created_at         DateTime             @default(now())

  details InventoryReturnDetail[]

  @@index([out_transaction_id])
  @@index([return_date])
  @@map("inventory_returns")
}

model InventoryReturnDetail {
  id                    String                     @id @default(uuid())
  return_id             String
  return                InventoryReturn            @relation(fields: [return_id], references: [id], onDelete: Cascade)
  transaction_detail_id String
  transaction_detail    InventoryTransactionDetail @relation(fields: [transaction_detail_id], references: [id], onDelete: Restrict)
  item_id               String
  item                  InventoryItem              @relation(fields: [item_id], references: [id], onDelete: Restrict)
  quantity              Decimal                    @db.Decimal(12, 2)
  condition             String                     @default("BAIK") // "BAIK", "RUSAK_RINGAN", "RUSAK_BERAT", "HILANG"
  serial_numbers        String?                    // JSON array string
  action_taken          String?                    // "Restocked to available", "Quarantined for repair", "Decommissioned", "Loss logged"
  notes                 String?

  @@index([return_id])
  @@index([transaction_detail_id])
  @@index([item_id])
  @@map("inventory_return_details")
}

model InventoryMovement {
  id             String                @id @default(uuid())
  item_id        String
  item           InventoryItem         @relation(fields: [item_id], references: [id], onDelete: Restrict)
  movement_type  String                // "IN", "OUT", "RETURN_GOOD", "RETURN_DAMAGED", "CONSUMED", "ADJUSTMENT"
  quantity       Decimal               @db.Decimal(12, 2)
  balance_before Decimal               @db.Decimal(12, 2)
  balance_after  Decimal               @db.Decimal(12, 2)
  reference_type String                // "TRANSACTION", "RETURN", "ADJUSTMENT", "OPNAME"
  reference_id   String
  transaction_id String?
  transaction    InventoryTransaction? @relation(fields: [transaction_id], references: [id], onDelete: SetNull)
  performed_by   String
  notes          String?
  created_at     DateTime              @default(now())

  @@index([item_id, created_at])
  @@index([reference_id])
  @@map("inventory_movements")
}

model InventoryAuditLog {
  id          String   @id @default(uuid())
  entity_type String   // "ITEM", "TRANSACTION", "RETURN", "PIC_LOCATION_EDIT", "STOCK_ADJUSTMENT"
  entity_id   String
  action      String   // "CREATE", "UPDATE", "CORRECTION", "EDIT_PIC_LOCATION", "ADJUST"
  user_id     String?
  user_name   String
  data_before String?  @db.Text
  data_after  String?  @db.Text
  reason      String?  @db.Text
  ip_address  String?
  created_at  DateTime @default(now())

  @@index([entity_type, entity_id])
  @@index([created_at])
  @@map("inventory_audit_logs")
}

model InventorySetting {
  id          String   @id @default(uuid())
  key         String   @unique
  value       String   @db.Text
  description String?
  updated_at  DateTime @default(now()) @updatedAt

  @@map("inventory_settings")
}

// ============================================================================
// SYSTEM UPDATE & FEATURE CHANGELOG HISTORY
// ============================================================================

model SystemUpdateHistory {
  id               String   @id @default(uuid())
  version          String
  previous_version String?
  title            String
  method           String   // "GIT_DOCKER" | "MANUAL_ZIP_BUNDLE" | "MANUAL_ZIP_SOURCE" | "BASELINE" | "MANUAL_NOTE"
  status           String   @default("APPLIED") // "APPLIED" | "STAGED_FOR_REBUILD" | "APPLYING" | "FAILED"
  commit_hash      String?
  branch           String?
  build_signature  String?
  file_name        String?
  file_size_bytes  Int?
  changelog_items  String   @default("[]") @db.Text
  notes            String?  @db.Text
  installed_by     String?
  installed_by_id  String?
  error_message    String?  @db.Text
  applied_at       DateTime @default(now())
  created_at       DateTime @default(now())
  updated_at       DateTime @default(now()) @updatedAt

  @@index([version, created_at])
  @@index([status, created_at])
  @@index([build_signature])
  @@index([created_at])
  @@map("system_update_histories")
}



