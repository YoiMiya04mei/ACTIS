# Dependencies
/node_modules
/.pnp
.pnp.js

# Next.js build outputs
/.next/
/out/
build/
dist/

# TypeScript cache
*.tsbuildinfo

# SQLite Local Database (seeded via prisma)
prisma/*.db
prisma/*.db-journal
prisma/*.db-wal
prisma/*.db-shm
*.db
*.db-journal

# Environment files
.env
.env*.local
!.env.example

# Logs
/logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# OS and IDE files
.DS_Store
Thumbs.db
.vscode/
.idea/

# Generated pdfjs-dist runtime assets (synced via predev / prebuild)
/public/pdfjs/

# User uploads & temporary files
/public/uploads/*
!/public/uploads/.gitkeep
/uploads/
*.pem
*.key
backup_export_*.zip

# Build metadata & local release/update artifacts
/build-info.json
/releases/
/updates/*
!/updates/.gitkeep
