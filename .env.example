# ==========================================
# ACTIS PRODUCTION ENVIRONMENT CONFIGURATION
# ==========================================

# Port Container yang diekspos ke Host Server (Default: 3000)
PORT=3000

# Base URL Web Application (Ganti dengan domain atau IP Server publik Anda)
NEXT_PUBLIC_APP_URL="https://actis.perusahaan-anda.net"

# ==========================================
# POSTGRESQL DATABASE CONFIGURATION
# ==========================================
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=actis_db
POSTGRES_PORT=15432

# Database Connection (Di dalam Docker Compose):
# DATABASE_URL="postgresql://postgres:postgres@postgres:5432/actis_db?schema=public"

# Database Connection (Di luar Docker / Host Local):
DATABASE_URL="postgresql://postgres:postgres@localhost:15432/actis_db?schema=public"

# Jalankan initial seed akun saat container pertama kali dibuat? (true / false)
INITIAL_SEED="false"

# ==========================================
# GOOGLE SPREADSHEET MIRROR (OPSIONAL)
# ==========================================
GOOGLE_APPS_SCRIPT_WEBHOOK_URL="https://script.google.com/macros/s/AKfycbz_SAMPLE_ACTIS_WEBHOOK/exec"

# Direct Service Account Google API (Jika menggunakan Service Account)
GOOGLE_SHEET_ID=""
GOOGLE_SERVICE_ACCOUNT_EMAIL=""
GOOGLE_PRIVATE_KEY=""

# ==========================================
# TELEGRAM BOT ALERT (ICMP PING UPTIME)
# ==========================================
# Konfigurasi bot notifikasi Telegram saat status ICMP ping DOWN dan UP (Recovered)
TELEGRAM_BOT_TOKEN="123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ"
TELEGRAM_CHAT_ID="-1001234567890"
TELEGRAM_NOTIF_ENABLED="true"

