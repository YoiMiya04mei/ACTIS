# ==========================================
# ACTIS PRODUCTION ENVIRONMENT CONFIGURATION
# ==========================================

# Port Container yang diekspos ke Host Server (Default: 3000)
PORT=3000

# Port TCP Server TACACS+ RFC 8907 (Default: 49)
TACACS_PORT=49

# Base URL Web Application (Ganti dengan domain atau IP Server publik Anda)
NEXT_PUBLIC_APP_URL="https://actis.perusahaan-anda.net"

# ==========================================
# SECURITY & CRYPTOGRAPHIC SESSION SECRET
# ==========================================
# WAJIB DIISI DI PRODUCTION: Secret kriptografis minimal 32 karakter untuk HMAC session token
# dan enkripsi AES-256-GCM. Buat dengan: openssl rand -hex 32
SESSION_SECRET="ganti-dengan-kunci-rahasia-kriptografis-minimal-32-karakter-acak"

# ==========================================
# POSTGRESQL DATABASE CONFIGURATION
# ==========================================
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=actis_db
POSTGRES_PORT=15432

# Database Connection (Di dalam Docker Compose):
# DATABASE_URL="postgresql://postgres:postgres@postgres:5432/actis_db?schema=public"

# Database Connection (Di luar Docker / Host Local):
DATABASE_URL="postgresql://postgres:postgres@localhost:15432/actis_db?schema=public"

# Jalankan initial seed akun saat container pertama kali dibuat? (true / false)
# Catatan: seed otomatis dilewati jika database sudah berisi data agar data existing aman.
INITIAL_SEED="false"

# Lewati `prisma db push` saat startup (set "true" bila update hanya kode/UI tanpa ubah schema.prisma)
SKIP_DB_SYNC="false"

# ==========================================
# GOOGLE SPREADSHEET MIRROR (OPSIONAL)
# ==========================================
GOOGLE_APPS_SCRIPT_WEBHOOK_URL="https://script.google.com/macros/s/AKfycbz_SAMPLE_ACTIS_WEBHOOK/exec"

# Direct Service Account Google API (Jika menggunakan Service Account)
GOOGLE_SHEET_ID=""
GOOGLE_SERVICE_ACCOUNT_EMAIL=""
GOOGLE_PRIVATE_KEY=""

# ==========================================
# TELEGRAM BOT ALERT (ICMP PING UPTIME)
# ==========================================
# Konfigurasi bot notifikasi Telegram saat status ICMP ping DOWN dan UP (Recovered)
TELEGRAM_BOT_TOKEN="123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ"
TELEGRAM_CHAT_ID="-1001234567890"
TELEGRAM_NOTIF_ENABLED="true"

# ==========================================
# TELEGRAM BOT NOTIFIKASI TIKET SELESAI
# ==========================================
# Opsional: Konfigurasi bot Telegram terpisah khusus saat tiket berstatus Completed
# (Tidak memakai token/chat ID dari ICMP Ping Monitor)
TICKET_TELEGRAM_BOT_TOKEN="987654321:XYZabcDefGhiJklMnoPqrStuVw"
TICKET_TELEGRAM_CHAT_ID="-1009876543210"
TICKET_TELEGRAM_NOTIF_ENABLED="false"

# ==========================================
# NETWORK CONFIG BACKUP & GOOGLE DRIVE SYNC (OPSIONAL)
# ==========================================
# Kunci enkripsi AES-256-GCM untuk password SSH & token Drive di DB (default memakai SESSION_SECRET)
# BACKUP_ENCRYPTION_KEY="ganti-dengan-string-acak-yang-panjang"
# Opsional bila menggunakan Google Drive OAuth2 API langsung
# GOOGLE_OAUTH_CLIENT_ID=""
# GOOGLE_OAUTH_CLIENT_SECRET=""

